{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npx --yes pnpm@11.19.0 install --frozen-lockfile",
  "buildCommand": "cd frontend && pnpm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://5.129.234.72/mailer/api/:path*"
    },
    {
      "source": "/backend-health",
      "destination": "https://5.129.234.72/mailer/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
